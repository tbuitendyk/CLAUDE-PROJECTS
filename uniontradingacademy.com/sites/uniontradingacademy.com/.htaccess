# Union Trading Academy — Apache config (IONOS shared hosting)
#
# Canonical URL: https://uniontradingacademy.com/
# Every other host/scheme combination 301s to it.

RewriteEngine On

# 1) Interim dev domain → main domain. Runs before the HTTPS rule so it works
#    over plain HTTP (the interim domain's own TLS is never needed for this hop).
RewriteCond %{HTTP_HOST} (^|\.)orderflowvolumeprofile\.com$ [NC]
RewriteRule ^(.*)$ https://uniontradingacademy.com/$1 [R=301,L]

# 2) www → apex
RewriteCond %{HTTP_HOST} ^www\.uniontradingacademy\.com$ [NC]
RewriteRule ^(.*)$ https://uniontradingacademy.com/$1 [R=301,L]

# 3) The site lived under /dev-ver during hidden-live development; keep old
#    links working now that the same content is served at the root.
RewriteRule ^dev-ver/?(.*)$ /$1 [R=301,L]

# 4) Force HTTPS. Verified on this host: Apache sees the real scheme —
#    HTTPS=on with SERVER_PORT 443, unset on port 80 — so this cannot loop.
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://uniontradingacademy.com/$1 [R=301,L]
