[Unit]
Description=bgutil PO-token provider for yt-dlp (localhost only)
Documentation=https://github.com/Brainicism/bgutil-ytdlp-pot-provider
After=network-online.target
Wants=network-online.target

[Service]
# Mints YouTube "Proof of Origin" tokens that yt-dlp needs to get real formats
# and download them in 2026. The Brainicism provider is a Node server; Node
# bundles its own TLS, so it runs on this box's OpenSSL 1.1 (the Rust build needs
# OpenSSL 3). Bound to loopback; deploy/install.sh builds it at pot-provider/.
User=dubber
Group=dubber
WorkingDirectory=/opt/youtube-dubber/pot-provider/server
ExecStart=/opt/youtube-dubber/node/bin/node /opt/youtube-dubber/pot-provider/server/build/main.js --port 4416
Restart=always
RestartSec=3
# Light hardening only -- the provider needs a writable cache (PrivateTmp gives
# it an isolated /tmp), so we avoid ProtectSystem/ProtectHome that could break it.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
