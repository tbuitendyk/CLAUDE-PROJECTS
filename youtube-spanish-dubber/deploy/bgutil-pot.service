[Unit]
Description=bgutil PO-token provider for yt-dlp (localhost only)
Documentation=https://github.com/jim60105/bgutil-ytdlp-pot-provider-rs
After=network-online.target
Wants=network-online.target

[Service]
# Mints YouTube "Proof of Origin" tokens that yt-dlp needs to download most 2026
# formats. Bound to loopback only -- nothing is exposed off the box.
User=dubber
Group=dubber
ExecStart=/opt/youtube-dubber/bin/bgutil-pot server --host 127.0.0.1 --port 4416
Restart=always
RestartSec=3
# Light hardening only -- the provider may need a writable cache, so we avoid
# ProtectSystem/ProtectHome that could silently break it.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
