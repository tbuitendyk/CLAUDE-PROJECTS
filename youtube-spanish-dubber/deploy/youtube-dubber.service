[Unit]
Description=YouTube Spanish Dubber service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dubber
Group=dubber
WorkingDirectory=/opt/youtube-dubber
EnvironmentFile=/opt/youtube-dubber/.env
ExecStart=/opt/youtube-dubber/.venv/bin/uvicorn youtube_dubber.app:app --host ${DUBBER_HOST} --port ${DUBBER_PORT}
Restart=on-failure
RestartSec=10

# Hardening (relaxed enough to allow downloading/encoding into WorkingDirectory,
# and to let libraries like Argos Translate / faster-whisper / torch create
# their cache dirs under the service user's own home, e.g. /home/dubber/.local
# and /home/dubber/.cache -- ProtectHome=true would hide /home/* entirely and
# crash the app on startup with "Permission denied: '/home/dubber'")
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/youtube-dubber

[Install]
WantedBy=multi-user.target
