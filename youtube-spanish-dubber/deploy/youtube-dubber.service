[Unit]
Description=YouTube Spanish Dubber service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dubber
Group=dubber
WorkingDirectory=/opt/youtube-dubber
EnvironmentFile=/opt/youtube-dubber/.env
ExecStart=/opt/youtube-dubber/.venv/bin/uvicorn youtube_dubber.app:app --host ${DUBBER_HOST} --port ${DUBBER_PORT}
# Restart=always (not just on-failure) so the in-app "Restart Dubber service"
# button can work by cleanly exiting the process and letting systemd respawn it.
Restart=always
RestartSec=3

# --- Resource limits ---------------------------------------------------------
# This host (16 GB) also runs two VirtualBox VMs allocated 6 GB each (~12 GB
# spoken for), so the dubber must stay bounded enough not to starve them.
#
# IMPORTANT: MemoryHigh is a *throttle*, NOT a kill. If it sits below a job's
# real working set, the kernel throttles the cgroup into a crawl and the job
# HANGS instead of finishing -- a Whisper transcription did exactly that, pinned
# at MemoryHigh=2G and burning CPU for ~12 h without completing. So MemoryHigh
# must stay ABOVE the working set: it only trims excess page cache, never
# throttles the compute.
#
# Keeping the working set BELOW this line is mostly the pipeline's job, not the
# ceiling's: the heavy models (Whisper, ONNX punctuation, spaCy, Argos) used to
# stack -- each stays cached as a singleton -- so a single dub's resident set
# grew past 3 GB and the kernel throttled it into the same crawl. The pipeline
# now releases each model the moment its stage finishes, *within* the job (see
# transcript.py / memory.release_to_os), so the set peaks at one stage's models
# (~1.5 GB) rather than the sum. MemoryMax is the hard ceiling -- exceed it and
# the cgroup restarts the service (freeing the RAM) rather than letting it grow
# into the VMs. Headroom math: 16 - 12 (VMs) - ~0.5 (host) leaves ~3.5 GB.
# Tune to your host's RAM / VM split, then re-deploy.
MemoryHigh=3G
MemoryMax=3584M

# Hardening (relaxed enough to allow downloading/encoding into WorkingDirectory,
# and to let libraries like Argos Translate / faster-whisper / torch create
# their cache dirs under the service user's own home, e.g. /home/dubber/.local
# and /home/dubber/.cache -- ProtectHome=true would hide /home/* entirely and
# crash the app on startup with "Permission denied: '/home/dubber'")
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/youtube-dubber

[Install]
WantedBy=multi-user.target
