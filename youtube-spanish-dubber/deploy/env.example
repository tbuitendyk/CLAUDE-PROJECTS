# Copy this file to .env (in the project root) and adjust as needed.
# Every value has a working default in youtube_dubber/config.py; you only
# strictly need to set the YouTube OAuth paths if you keep secrets elsewhere.

# --- Service ---
DUBBER_HOST=127.0.0.1
DUBBER_PORT=8088

# --- Storage ---
DUBBER_DATA_DIR=./data
DUBBER_DB_PATH=./data/jobs.sqlite3

# --- Dubbing language ---
DUBBER_TARGET_LANGUAGE=es

# --- Text-to-speech voice (run `edge-tts --list-voices | grep es-` for options) ---
# Spanish (Spain) male:    es-ES-AlvaroNeural
# Spanish (Spain) female:  es-ES-ElviraNeural
# Spanish (Mexico) male:   es-MX-JorgeNeural
# Spanish (Mexico) female: es-MX-DaliaNeural
# Spanish (Latin Am.):     es-419-... (varies by Edge release)
DUBBER_TTS_VOICE=es-ES-AlvaroNeural
DUBBER_TTS_RATE=+0%

# --- Whisper fallback (only used when a video has zero usable captions) ---
# Bigger = more accurate but slower/heavier. tiny/base/small/medium/large-v3
DUBBER_WHISPER_MODEL=small
DUBBER_WHISPER_DEVICE=cpu
DUBBER_WHISPER_COMPUTE_TYPE=int8

# --- Audio mixing ---
# replace: new Spanish narration is the only audio track (clean dub)
# duck:    original audio kept underneath at low volume (telenovela style)
DUBBER_AUDIO_MODE=replace
DUBBER_DUCK_VOLUME=0.12

# --- YouTube upload ---
DUBBER_YT_CLIENT_SECRETS=./secrets/client_secret.json
DUBBER_YT_TOKEN_FILE=./secrets/token.json
# Cookies for yt-dlp's *download* side (NOT the OAuth upload above). YouTube
# bot-checks datacenter IPs ("Sign in to confirm you're not a bot"); export a
# youtube.com cookies.txt (Netscape format) from a signed-in -- ideally
# throwaway -- account and drop it here. Optional; absent = no cookies.
DUBBER_YT_COOKIES_FILE=./secrets/youtube_cookies.txt
# yt-dlp player-client selection. The downloader auto-resolves a working client
# on its first extraction (the first in DUBBER_YTDLP_CLIENT_LADDER that returns
# real formats) and caches it. The ladder LEADS WITH "default" on purpose:
# pinning a single client restricts yt-dlp to only that one, while the default
# runs its full cascade incl. the token-exempt android_vr client that returns
# formats when web/tv come back empty. Run `python -m youtube_dubber.cli
# check-extraction` to see per-client results. Set DUBBER_YTDLP_PLAYER_CLIENTS
# to hard-pin one and skip auto-resolution.
# DUBBER_YTDLP_PLAYER_CLIENTS=default
# DUBBER_YTDLP_CLIENT_LADDER=default,web,mweb,web_safari,tv
# Rescue videos whose only formats are GVS-token-gated (yt-dlp formats=missing_pot):
# DUBBER_YTDLP_INCLUDE_MISSING_POT=true
# Optional proxy for ALL extraction. YouTube serves metadata to flagged
# datacenter IPs but withholds the media streams (no real formats); routing
# yt-dlp through a residential/clean egress is the cure. http(s) or socks5.
# DUBBER_YTDLP_PROXY=socks5://127.0.0.1:1080
# private | unlisted | public  (start with "private" or "unlisted" until you trust the output!)
DUBBER_UPLOAD_PRIVACY=unlisted
DUBBER_UPLOAD_CATEGORY=22
DUBBER_TITLE_PREFIX=[ES]
DUBBER_DESCRIPTION_SUFFIX="\n\n---\nVoz en español generada automáticamente a partir del video original."

# --- Thumbnail branding ---
# Reuse the source video's thumbnail for the dub, with a small banner overlaid.
# Applied via the YouTube API after upload (needs a verified channel; if that
# fails the dub still publishes, just with YouTube's auto-thumbnail).
DUBBER_THUMBNAIL_ENABLED=true
DUBBER_THUMBNAIL_BANNER_TEXT=Versión Español
# Optional explicit .ttf font; empty = autodetect DejaVu (installed by install.sh).
DUBBER_THUMBNAIL_FONT=

# --- Worker ---
DUBBER_POLL_INTERVAL=5
DUBBER_KEEP_WORK_DIRS=false
# Free the heavy ML models (Whisper / Argos / ONNX) when the queue goes idle so
# an idle service doesn't sit on hundreds of MB of RAM. They reload on the next
# job. Set false only if you'd rather trade idle RAM for warm-start latency.
DUBBER_RELEASE_MODELS_WHEN_IDLE=true
