[Unit]
Description=Semi-Auto Balancer (price watcher + web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=balancer
Group=balancer
WorkingDirectory=/opt/semi-auto-balancer
# PORT, SMTP creds, ALERT_EMAIL_TO etc. live here (root:balancer 640).
EnvironmentFile=/etc/semi-auto-balancer/env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/semi-auto-balancer/data

[Install]
WantedBy=multi-user.target
