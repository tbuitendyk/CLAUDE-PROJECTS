[Unit]
Description=General Classifier (Binance weekly-chunk classifier + web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=classifier
Group=classifier
WorkingDirectory=/opt/general-classifier
EnvironmentFile=/etc/general-classifier/env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/general-classifier/data

[Install]
WantedBy=multi-user.target
