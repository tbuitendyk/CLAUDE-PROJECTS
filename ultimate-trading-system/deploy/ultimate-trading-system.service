[Unit]
Description=Ultimate Trading System (Construct + Trade, deterministic; no AI in any path)
After=network-online.target
Wants=network-online.target
# A broken start must PARK, not respawn for ever. systemd's defaults
# (5 starts in 10s) are never reached at RestartSec=5, so without these a
# failing service would write to the shared journal indefinitely on a box that
# also holds the owner's live books.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=uts
Group=uts
WorkingDirectory=/opt/ultimate-trading-system
EnvironmentFile=/etc/ultimate-trading-system/env
# Belt and braces on the port: the env file is not the only source, so an env
# file that lost its PORT line cannot land this service on 8093, which the
# previous generation is still serving live trading and paper books on.
Environment=PORT=8094
# THE HEAP CEILING IS SET HERE, not left to node (owner, 2026-08-22). Node's
# own default old-space limit is about 1 GB on 64-bit, so the first wide sweep
# died at 1024 MB with two thirds of its allowance untouched. The ceiling is
# stated here, and it is kept just under MemoryHigh so that MemoryMax stays the
# backstop it was written to be rather than the thing that bites first.
#
# RAISED 1792 -> 3072 MB (owner order, 2026-08-30: "define a larger heap going
# forward that will persist"). Three deaths this month were all the same shape —
# "Ineffective mark-compacts near heap limit", which is not a heap that is too
# small for the data so much as one with no room to collect in: the collector
# runs continuously, reclaims almost nothing, and every page load waits behind
# it. The set that now lives here holds 524,832 settings whose finished tables
# want about 1.3 GB, and the service was asked to hold that plus a request plus
# a rebuild inside 1.75 GB.
#
# WHY 3072 AND NOT MORE, as it stood. This box has 16 GB and two VirtualBox
# guests held 10.4 of it (5,974 MB and 4,387 MB). Everything else runs in about
# 700 MB. 3072 MB of heap plus node's own non-heap footprint peaked around
# 3.5 GB, which left roughly a gigabyte of physical memory and 3.4 GB of swap as
# slack. Going further would have pushed the guests' pages out to swap, which
# is the owner's mail and business machines, and that is a worse outcome than a
# slow page.
#
# RAISED 3072 -> 5120 MB (owner order, 2026-09-22: "raise the cage to 6 gb").
# The owner took 4 GB back from the two guests that day (2 GB from each), so
# they hold about 6.5 GB now. 6 GB for this service beside them and the 700 MB
# of everything else is about 13.2 GB of the 16, with the rest and the swap as
# slack. The heap sits 512 MB under MemoryHigh as before, for node's non-heap
# footprint, and MemoryHigh 512 MB under MemoryMax, so the soft brake still
# comes before the hard cap.
#
# THE GATE FOLLOWS THIS NUMBER BY ITSELF. lib/estimate.js reads the ceiling out
# of the running process's own arguments, so the refusal that stops a set whose
# tables cannot fit moves with it — at 5 coins it goes from about 578,000
# settings to about 990,000, and the owner's set drops from "tight" to "fits".
ExecStart=/usr/bin/node --max-old-space-size=5120 server.js
Restart=on-failure
RestartSec=5

# This box already runs the previous generation, two VirtualBox guests and the
# other services, and neither unit carried any limit. A sweep here could starve
# the live trading rail, and a memory spike could invite the kernel to kill the
# wrong process. These bound THIS service only; putting a weight on the old unit
# would be a change to the running system and needs its own go-ahead.
CPUWeight=50
CPUQuota=300%
# THE HARD CAP IS WHAT PROTECTS THE REST OF THE BOX, and it is why the heap
# above can be raised at all. MemoryMax is a cgroup boundary: if this service
# overreaches, the kernel kills THIS service and not one of the guests. Without
# it, a spike here would leave the kernel choosing a victim by its own reckoning
# on a box that also holds the owner's mail and business machines.
#
# High is the soft brake and sits just above where the heap is expected to peak,
# so ordinary work never touches it and a runaway is throttled and reclaimed
# before Max ends it. Raised with the heap, 2G/3G -> 3.5G/4G (2026-08-30), and
# again 3.5G/4G -> 5.5G/6G (2026-09-22, "raise the cage to 6 gb").
MemoryHigh=5632M
MemoryMax=6G
IOWeight=50

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ultimate-trading-system/data

[Install]
WantedBy=multi-user.target
