[Unit]
Description=Ultimate Trading System (Construct + Trade, deterministic; no AI in any path)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uts
Group=uts
WorkingDirectory=/opt/ultimate-trading-system
EnvironmentFile=/etc/ultimate-trading-system/env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ultimate-trading-system/data

[Install]
WantedBy=multi-user.target
