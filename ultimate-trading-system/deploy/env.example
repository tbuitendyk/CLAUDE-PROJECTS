# Ultimate Trading System environment. Nothing secret lives here; the service
# has no accounts, no keys and no AI/API access of any kind (CLAUDE.md RULE
# SEVEN). PORT must match the nginx location on the website branch
# (/uts/ -> 127.0.0.1:8094). 8093 belongs to the previous generation, which
# keeps running untouched on its own service.
PORT=8094

# DO NOT ADD PILOT_SOCKS OR ANY TUNNEL SETTING HERE. The box carries one
# persistent SSH forward whose exit address is pinned to the owner's exchange
# account, and it belongs to the previous generation's live trading rail. This
# service must not route through it: a second process on that tunnel changes
# what the exchange sees, from a single line in this file.
