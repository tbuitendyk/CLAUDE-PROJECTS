# Copy to .env and `set -a; source .env; set +a` before `npm start`
# (or configure these in your process manager / systemd unit).

PORT=3000

# Password for the web UI. Leave empty to disable auth (not recommended
# if the app is reachable from the internet).
APP_PASSWORD=change-me

# Where rebalance alerts are sent.
ALERT_EMAIL_TO=tbuitendyk@gmail.com
ALERT_EMAIL_FROM=

# SMTP — for Gmail use smtp.gmail.com:587 with an App Password
# (Google account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Default poll cadence (minutes) for new profiles.
POLL_MINUTES=15

# Optional CoinGecko demo API key for higher rate limits.
COINGECKO_API_KEY=
