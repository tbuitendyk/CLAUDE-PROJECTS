# /etc/asset-balancer/env -- environment for the asset-balancer systemd unit.
# install.sh copies this template there on first install; edit the real file
# on the box (root:balancer 640) and `systemctl restart asset-balancer`.

# The nginx vhost on the website branch proxies /balancer/ here.
# 8088 = dubber, 8090 = deploy-control; 8091 is the balancer's.
PORT=8091

# The /balancer/ location is already gated by the site's HTTP Basic Auth
# (same .htpasswd as the dubber), so the app's own login can stay disabled.
# Set a password here only if you want a second, app-level gate.
APP_PASSWORD=

# Where rebalance alerts are sent.
ALERT_EMAIL_TO=theodore@buitendyk.ca
ALERT_EMAIL_FROM=

# SMTP -- e.g. the local iRedMail server or Gmail with an App Password.
# configure-balancer-email.sh (vps-access branch) fills these in with the
# same authenticated-submission path mail-test.sh uses: the mail VM at
# 192.168.56.129:587 as support@homeandofficemicro.com, self-signed cert
# allowed via SMTP_ALLOW_SELF_SIGNED.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_ALLOW_SELF_SIGNED=false
SMTP_USER=
SMTP_PASS=

# Default poll cadence (minutes) for new profiles.
POLL_MINUTES=15

# Optional CoinGecko demo API key for higher rate limits.
COINGECKO_API_KEY=
