# Postfix transport map: recipient domain -> relay transport.
#
# Domains listed here are sent via the Brevo smarthost. Everything not in this
# file falls through to Postfix's default transport (direct delivery).
#
# Format:
#   recipient.domain     relay:[smtp-relay.brevo.com]:587
#   .recipient.domain    relay:[smtp-relay.brevo.com]:587   (matches subdomains)
#
# After editing, regenerate the .db and reload Postfix:
#   sudo postmap /etc/postfix/transport_brevo
#   sudo postfix reload

# --- Microsoft consumer mail (outlook.com / hotmail / live / msn family) ---
outlook.com         relay:[smtp-relay.brevo.com]:587
outlook.co.uk       relay:[smtp-relay.brevo.com]:587
